rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 식사 사진: 로그인한 사람만 올리고(5MB 이하 이미지, 내 파일 이름만), 로그인한 사람만 읽어요.
    match /meals/{roomId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file.matches('.*_' + request.auth.uid + '\\.jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && file.matches('.*_' + request.auth.uid + '\\.jpg');
    }
  }
}
