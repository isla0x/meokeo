rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 별명: 로그인한 사람은 누구나 읽고, 내 것만 써요.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 초대 코드 → 방 연결표. 코드를 알아야만 한 건씩 읽을 수 있고(목록 조회 불가), 방장만 만들고 지워요.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.ownerId == request.auth.uid;
    }

    match /rooms/{roomId} {
      // 방 구성원만 읽어요. (참여 전에는 코드 표를 거쳐 방 번호만 알아요)
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      // 방 만들기: 내가 방장이고 구성원은 나 혼자.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if request.auth != null && (
        // 구성원이 방 정보를 고치거나 나가는 경우
        (request.auth.uid in resource.data.members
          && request.resource.data.members.size() <= 4
          && request.resource.data.ownerId in request.resource.data.members)
        ||
        // 코드로 참여하는 경우: 나 한 명만 늘고 최대 4명
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 4
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code)
      );

      allow delete: if request.auth != null
        && resource.data.members == [request.auth.uid];

      // 식사 사진 글: 방 구성원만 읽고, 내 글만 쓰고 지워요. (글 번호 = 날짜_끼니_내uid)
      match /posts/{postId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
        allow create, update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members
          && request.resource.data.uid == request.auth.uid
          && postId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(breakfast|lunch|dinner)_' + request.auth.uid + '$')
          && request.resource.data.text.size() <= 30
          && request.resource.data.photo.size() < 800000;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
